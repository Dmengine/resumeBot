# Required: Your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: OpenRouter model to use for resume analysis.
# Default is mistralai/mistral-7b-instruct:free (free tier, no credits required).
# Other examples:
#   mistralai/mistral-7b-instruct:free   (free tier)
#   openai/gpt-4o-mini                   (requires OpenAI credits via OpenRouter)
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Optional: Port the backend listens on (default: 5050)
PORT=5050
